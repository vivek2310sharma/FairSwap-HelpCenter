{
  "name": "fairswap-helpcenter",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx scripts/content.ts && next dev",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "content:check": "tsx scripts/content.ts",
    "test": "vitest run",
    "build": "tsx scripts/content.ts && next build",
    "start": "next start",
    "test:browser": "playwright test",
    "test:production": "node scripts/check-production.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7",
    "gray-matter": "4.0.3",
    "react-markdown": "10.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "tailwindcss": "4.3.3",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.3",
    "tsx": "4.20.6",
    "vitest": "4.0.18",
    "@playwright/test": "1.64.1",
    "@axe-core/playwright": "4.11.0",
    "prettier": "3.6.2"
  }
}
